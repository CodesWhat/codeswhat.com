{
  "name": "codeswhat",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "description": "CodesWhat: small, sharp open-source tools and software consulting",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "tsc --noEmit",
    "check": "biome check . && npm run type-check",
    "check:all": "biome check . && npm run type-check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:support": "node --experimental-strip-types --test test/support.test.ts",
    "test:subscribe": "node --experimental-strip-types --import ./test/resolve-next-server.mjs --test test/subscribe-turnstile.test.ts",
    "test:scene": "node --test test/scene.test.mjs",
    "test:posthog": "node --experimental-strip-types --test test/posthog.test.ts test/posthog-source.test.mjs",
    "test:posthog:browser": "node --test test/posthog-browser.test.mjs",
    "test:browser": "node --test test/site-browser.test.mjs",
    "test:browser:all": "BROWSER_ENGINE=chromium npm run test:browser && BROWSER_ENGINE=firefox npm run test:browser && BROWSER_ENGINE=webkit npm run test:browser",
    "og": "node scripts/generate-og.mjs",
    "coin": "node scripts/capture-assets.mjs --subject coin",
    "balloon": "node scripts/capture-assets.mjs --subject balloon",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "next": "^16.4.5",
    "posthog-js": "1.447.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2"
  }
}
