{
  "name": "codeswhat",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "description": "CodesWhat: small, sharp open-source tools and software consulting",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "tsc --noEmit",
    "check": "biome check . && npm run type-check",
    "check:all": "biome check . && npm run type-check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:support": "node --experimental-strip-types --test test/support.test.ts",
    "test:scene": "node --test test/scene.test.mjs",
    "test:posthog": "node --experimental-strip-types --test test/posthog.test.ts test/posthog-source.test.mjs",
    "test:posthog:browser": "node --test test/posthog-browser.test.mjs",
    "test:browser": "node --test test/site-browser.test.mjs",
    "og": "node scripts/generate-og.mjs",
    "coin": "node scripts/capture-assets.mjs --subject coin",
    "balloon": "node scripts/capture-assets.mjs --subject balloon",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "next": "^16.2.11",
    "posthog-js": "1.417.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "lefthook": "^2.1.2",
    "playwright-core": "^1.61.1",
    "typescript": "^5.9.3"
  }
}
