# EmailOctopus API Configuration (Required for email signup)
EMAILOCTOPUS_API_KEY=REDACTED
EMAILOCTOPUS_LIST_ID=REDACTED

# Cloudflare Turnstile guards /api/subscribe (both required for signup).
# The site key is public and baked in at build time; the secret stays server-side.
# Cloudflare's published test pair for local work: 1x00000000000000000000AA and
# 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x_replace_with_widget_site_key
TURNSTILE_SECRET_KEY=0x_replace_with_widget_secret_key

# Site Configuration (Optional - has defaults)
NEXT_PUBLIC_SITE_NAME=CodesWhat?
NEXT_PUBLIC_SITE_DESCRIPTION=Where curiosity meets code - Digital solutions and software consulting
NEXT_PUBLIC_SITE_URL=https://codeswhat.com/

# PostHog is intentionally production-only. Preview/development stay unset.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replace_in_Vercel_Production_only
# NEXT_PUBLIC_POSTHOG_HOST=https://e.codeswhat.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Vercel automatically provides these:
# VERCEL_URL - The domain of the deployment
# VERCEL_ENV - The environment (production, preview, development)
