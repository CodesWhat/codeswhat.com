}
```

## Common Patterns

### Blog Post List
```typescript
// app/blog/page.tsx
import { getPosts } from '@/lib/posts'
import { PostCard } from '@/components/post-card'

export default async function BlogPage() {
  const posts = await getPosts()
  
  return (
    <div className="container py-10">
      <h1 className="text-4xl font-bold mb-8">Blog</h1>
      <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard key={post.slug} post={post} />
        ))}
      </div>
    </div>
  )
}
```

### Contact Form (Server Actions)
```typescript
// app/contact/actions.ts
'use server'

import { z } from 'zod'
import { resend } from '@/lib/resend'

const schema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
  message: z.string().min(10)
})

export async function sendMessage(formData: FormData) {
  const parsed = schema.parse({
    name: formData.get('name'),
    email: formData.get('email'),
    message: formData.get('message')
  })
  
  await resend.emails.send({
    from: 'contact@yoursite.com',
    to: 'you@email.com',
    subject: `Contact from ${parsed.name}`,
    text: parsed.message
  })
}
```

## Error Handling

### Error Boundaries
```typescript
// app/error.tsx
'use client'

export default function Error({
  error,
  reset,
}: {
  error: Error & { digest?: string }
  reset: () => void
}) {
  return (
    <div className="flex flex-col items-center justify-center min-h-[400px]">
      <h2 className="text-2xl font-bold mb-4">Something went wrong!</h2>
      <Button onClick={() => reset()}>Try again</Button>
    </div>
  )
}
```

### Loading States
```typescript
// app/blog/loading.tsx
import { Skeleton } from "@/components/ui/skeleton"

export default function Loading() {
  return (
    <div className="container py-10">
      <Skeleton className="h-10 w-[200px] mb-8" />
      <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {Array.from({ length: 6 }).map((_, i) => (
          <Skeleton key={i} className="h-[300px]" />
        ))}
      </div>
    </div>
  )
}
```

## Code Quality & Linting

### Linting Tools
- **ESLint**: Already configured with Next.js
- **Prettier**: For consistent code formatting
- **TypeScript**: Built-in type checking

### Running Linters
```bash
# Run ALL checks with one command
npm run check          # Runs ESLint + TypeScript checking
npm run check:all      # Runs ESLint + TypeScript + Prettier check

# Individual commands
npm run lint           # ESLint only
npm run lint:fix       # ESLint with auto-fix
npm run type-check     # TypeScript type checking
npm run format         # Prettier format all files
npm run format:check   # Check if files are formatted

# Before committing
npm run check:all      # Ensures code quality
```

### Prettier Configuration (.prettierrc)
```json
{
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss"]
}
```

### Pre-commit Hooks (Optional)
```bash
# Install husky and lint-staged
npm install -D husky lint-staged

# Add to package.json
"lint-staged": {
  "*.{js,jsx,ts,tsx}": [
    "eslint --fix",
    "prettier --write"
  ]
}
```

### VS Code Settings
```json
{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  }
}
```

## Testing Approach
- Unit tests for utilities: Vitest
- Component tests: React Testing Library
- E2E tests: Playwright
- Run tests before deployment

## Performance Monitoring
- Use Vercel Analytics for Core Web Vitals
- Monitor bundle size with `next-bundle-analyzer`
- Implement proper error tracking (Sentry)

## Upgrading Existing Projects

### To Latest Versions
```bash
# Update Next.js to latest
npm update next@latest react@latest react-dom@latest

# For Tailwind v4 (if using v3)
npm install tailwindcss@next @tailwindcss/postcss@next

# Update shadcn components
npx shadcn@canary diff  # Check what changed
npx shadcn@canary add [component] --overwrite  # Update specific component
```

### Version Compatibility
- Next.js 15.3+ requires Node.js 20.9.0+
- Tailwind v4 works best with PostCSS 8.4+
- shadcn/ui canary supports both Tailwind v3 and v4

